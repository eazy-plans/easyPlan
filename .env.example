# Copy to .env.local and fill in values for YOUR environment.
# Never put real production values in this file, and never commit .env.local
# (it's already in .gitignore). Dev/preview and production must use separate
# Supabase projects, separate Resend keys, and a separate CRON_SECRET - see
# README.md "Environments" for how to set each one up.

# Supabase project (Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key: server-only, bypasses Row Level Security.
# Must NEVER be prefixed with NEXT_PUBLIC_ - that would ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email). Use a separate API key (or Resend's sandbox/test mode) in
# dev so test runs never email real customers.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# Random secret checked against the Authorization header on /api/cron/*.
# Generate a separate value per environment, e.g.: openssl rand -hex 32
CRON_SECRET=

# Geocoding (venue map) uses Nominatim/OpenStreetMap - no API key needed.
